# WAYANG ID — Environment Configuration
# Salin file ini menjadi .env.local untuk konfigurasi lokal

# Appwrite Cloud Credentials
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT=wayangid-salatiga
APPWRITE_API_KEY=your_appwrite_api_key_here

# Appwrite Database & Storage
NEXT_PUBLIC_APPWRITE_DATABASE_ID=wayangdb
NEXT_PUBLIC_APPWRITE_BUCKET_TALENT_PHOTOS=talent-photos
NEXT_PUBLIC_APPWRITE_BUCKET_PORTFOLIO_MEDIA=portfolio-media
NEXT_PUBLIC_APPWRITE_BUCKET_QR=qr

# Application Base URL (digunakan untuk link QR Code dan share)
NEXT_PUBLIC_APP_URL=http://localhost:3000
